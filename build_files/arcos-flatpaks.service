[Unit]
Description=Install ArcOS default Flatpak applications
Documentation=https://github.com/saerio/ArcOS
# Network readiness is handled by the script's own retry loop, so we do NOT
# gate on network-online.target (it can be "reached" with no real connectivity,
# which would block this unit forever on systems without auto-connecting
# network). Triggered by arcos-flatpaks.timer.

[Service]
Type=oneshot
ExecStart=/usr/sbin/arcos-install-flatpaks.sh
# The script always exits 0; retries are driven by the marker file + timer,
# not by the service exit code, so this never shows as a failed unit.
SuccessExitStatus=0
